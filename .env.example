# Base Postgres utilisee par Payload.
# En local, faites pointer cette variable sur votre Postgres de DEV, jamais sur la production.
DATABASE_URI=postgresql://postgres:motdepasse@localhost:5432/spanishfutsal

# Secret de signature des tokens Payload (chaine aleatoire longue).
PAYLOAD_SECRET=

# Protege la route d import LFFS (/api/import/trigger).
CRON_SECRET=

# Envoi des mails du formulaire de contact.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stockage des medias (Vercel Blob). Sans ce token, les fichiers restent sur le disque local.
BLOB_READ_WRITE_TOKEN=

# --- Utilise uniquement par pnpm schema:push:prod ---
# Production, ECRITE : c est sur cette base que le schema est applique avant un deploiement.
PROD_DATABASE_URI=

# --- Utilise uniquement par scripts/db-refresh.mjs ---
# Connexion DIRECTE a la production (port 5432, pas le pooler 6543) : source du dump, lue seulement.
SOURCE_DATABASE_URI=
# Base de dev locale : cible du dump, son schema public est ECRASE.
TARGET_DATABASE_URI=postgresql://postgres:motdepasse@localhost:5432/spanishfutsal
