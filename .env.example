# Base Postgres utilisee par Payload. Le developpement et la production partagent
# la meme base. Le schema ne se synchronise plus au demarrage : il passe par les
# migrations (pnpm migrate:create, puis pnpm migrate). Voir docs/base-de-donnees.md.
DATABASE_URI=

# Secret de signature des tokens Payload (chaine aleatoire longue).
PAYLOAD_SECRET=

# Protege la route d import LFFS (/api/import/trigger) et les jobs du Hub :
# la reconciliation quotidienne des matchs (/api/hub/synchro-matchs).
CRON_SECRET=

# Envoi des mails du formulaire de contact.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stockage des medias (Vercel Blob). Sans ce token, les fichiers restent sur le disque local.
BLOB_READ_WRITE_TOKEN=

# Detection automatique du live YouTube (/api/live-status).
# Cle API YouTube Data v3, restreinte a cette seule API. Sans elle, le site
# s'en tient au champ "Lien Live" saisi dans l'admin.
YOUTUBE_API_KEY=
# Facultatif : identifiant de la chaine (UC...). Laisse vide, il est resolu
# depuis le handle @UDAsturiana et garde un mois en cache.
YOUTUBE_CHANNEL_ID=

# Adresse publique du Hub, dans les liens des flux iCal et les QR codes.
# Laisse vide, c est l adresse du site (https://www.udasturiana.be).
HUB_BASE_URL=

# Notifications push du Hub. Cles VAPID a generer une fois :
#   node -e "const k=require('web-push').generateVAPIDKeys();console.log(k)"
# La cle publique est envoyee au navigateur, la privee signe les envois.
# Le sujet est une adresse de contact pour les services push (mailto:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@udasturiana.be

# --- Les variables ci-dessous ne servent que si le dev est separe de la prod ---

# --- Utilise uniquement par scripts/db-refresh.mjs ---
# Connexion DIRECTE a la production (port 5432, pas le pooler 6543) : source du dump, lue seulement.
SOURCE_DATABASE_URI=
# Base de dev locale : cible du dump, son schema public est ECRASE.
TARGET_DATABASE_URI=postgresql://postgres:motdepasse@localhost:5432/spanishfutsal
